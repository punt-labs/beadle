{"ts":"2026-08-31T14:15:41.544919807Z","session":"db7ba632-660e-41c7-bace-799ed3f6d8a2","agent_id":"arev-invariant-d1f64b9173a77bf7","agent_type":"rev-invariant","tool":"Bash","tool_input":{"command":"cat \u003e .tmp/canoncheck/cases2.go \u003c\u003c'EOF'\npackage main\n\nimport \"fmt\"\n\nfunc init() { extra = map[string]string{\n\t\"nel-in-prompt\":      \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema: text\\nprompt: \\\"a\\\\u0085b\\\"\\n\",\n\t\"lsep-in-prompt\":     \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema: text\\nprompt: \\\"a\\\\u2028b\\\"\\n\",\n\t\"nbsp-in-prompt\":     \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema: text\\nprompt: \\\"a\\\\u00a0b\\\"\\n\",\n\t\"long-key\":           \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema:\\n  \" + rep(\"k\", 200) + \": v\\n\",\n\t\"long-quoted-val\":    \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema: text\\ndescription: \\\"\" + rep(\"ab \", 60) + \"\\\"\\n\",\n\t\"double-space-fold\":  \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema: text\\nprompt: \\\"\" + rep(\"word  \", 40) + \"\\\"\\n\",\n\t\"trailing-nl-prompt\": \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema: text\\nprompt: \\\"body\\\\n\\\"\\n\",\n\t\"only-newlines\":      \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema: text\\nprompt: \\\"\\\\n\\\\n\\\\n\\\"\\n\",\n\t\"leading-space\":      \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema: text\\nprompt: \\\"  indented\\\"\\n\",\n\t\"tab-start-line\":     \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema: text\\nprompt: \\\"a\\\\n\\\\tb\\\"\\n\",\n\t\"schema-big-int\":     \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema:\\n  n: 18446744073709551615\\n\",\n\t\"schema-octal\":       \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema:\\n  n: 0o17\\n  m: 0x1f\\n\",\n\t\"schema-inf-nan\":     \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema:\\n  a: .inf\\n  b: .nan\\n\",\n\t\"schema-ts\":          \"name: x\\nrunner: cli\\nbinary: b\\noutput_schema:\\n  t: